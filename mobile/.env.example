# Local overrides for CareRing Mobile Client
# Optional: Set this if you want to explicitly override the backend URL
# For local run: ws://192.168.1.3:4000 or ws://127.0.0.1:4000
# For deployed API: wss://care-ring.onrender.com
# EXPO_PUBLIC_BACKEND_URL=ws://192.168.1.3:4000
# EXPO_PUBLIC_LANDING_URL=https://care-ring.netlify.app

# Google Cloud OAuth 2.0 Web Client ID (from Google Cloud Console)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
