{
  "name": "care-ring-mobile",
  "version": "1.0.4",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-auth-session": "~58.0.14",
    "expo-battery": "~58.0.3",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:local": "expo start -c",
    "start:deployed": "EXPO_PUBLIC_BACKEND_URL=wss://care-ring.onrender.com expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate:assets": "node scripts/generate-assets.js && node scripts/generate-siren.js",
    "build:apk": "node scripts/generate-assets.js && cd android && EXPO_PUBLIC_BACKEND_URL=wss://care-ring.onrender.com ./gradlew assembleRelease",
    "build:apk:local": "node scripts/generate-assets.js && cd android && ./gradlew assembleDebug",
    "build:eas:apk": "eas build --platform android --profile preview",
    "build:eas:prod": "eas build --platform all --profile production",
    "export:web": "EXPO_PUBLIC_BACKEND_URL=wss://care-ring.onrender.com expo export -p web"
  },
  "private": true
}
