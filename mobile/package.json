{
  "name": "care-ring-mobile",
  "version": "1.0.4",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.14",
    "expo-battery": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:local": "expo start -c",
    "start:deployed": "EXPO_PUBLIC_BACKEND_URL=wss://care-ring.onrender.com expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate:assets": "node scripts/generate-assets.js",
    "build:apk": "node scripts/generate-assets.js && cd android && EXPO_PUBLIC_BACKEND_URL=wss://care-ring.onrender.com ./gradlew assembleRelease",
    "build:apk:local": "node scripts/generate-assets.js && cd android && ./gradlew assembleDebug",
    "build:eas:apk": "eas build --platform android --profile preview",
    "build:eas:prod": "eas build --platform all --profile production",
    "export:web": "EXPO_PUBLIC_BACKEND_URL=wss://care-ring.onrender.com expo export -p web"
  },
  "private": true
}
