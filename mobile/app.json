{
  "expo": {
    "name": "CareRing",
    "slug": "carering",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1D"
    },
    "ios": {
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.carering.app",
      "buildNumber": "4",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "We need your location to share your real-time position with your family circle.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Background location allows your circle to receive arrival alerts even when the app is closed.",
        "NSLocationAlwaysUsageDescription": "Background location allows your circle to receive arrival alerts even when the app is closed.",
        "NSMotionUsageDescription": "Motion sensors detect when you are stationary or driving to optimize battery consumption."
      }
    },
    "scheme": "carering",
    "android": {
      "userInterfaceStyle": "automatic",
      "package": "com.carering.app",
      "versionCode": 4,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "carering"
            },
            {
              "scheme": "https",
              "host": "care-ring.netlify.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "ACTIVITY_RECOGNITION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "62dceb49-950e-4a87-9b07-6d23a0953b45"
      }
    },
    "owner": "sunnyfountane",
    "plugins": [
      "expo-splash-screen",
      "expo-system-ui",
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Background location allows your circle to receive arrival alerts even when the app is closed.",
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
