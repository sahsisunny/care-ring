# Server Network Configuration
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://carering_user:carering_secure_password@localhost:5433/carering

# Free Reverse Geocoding (Nominatim OpenStreetMap - zero API key required)
GEOCODING_PROVIDER=nominatim

# Stationary & "Since" Detection Thresholds
STATIONARY_RADIUS_METERS=50
STATIONARY_DURATION_THRESHOLD_MS=180000

# Social Authentication Settings (Self-Hosted: AT LEAST ONE IS REQUIRED)
# Login is exclusively social (Google & Apple) with zero password storage.
# When self-hosting your server, you must configure at least one of the following:
# 1. GOOGLE_CLIENT_ID: OAuth 2.0 Web Client ID from Google Cloud Console
# 2. APPLE_CLIENT_ID: Apple Service ID or Bundle ID from Apple Developer Portal
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# APPLE_CLIENT_ID=com.carering.app
