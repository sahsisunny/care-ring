# Server Network Configuration
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://carering_user:carering_secure_password@localhost:5433/carering

# Free Reverse Geocoding (Nominatim OpenStreetMap - zero API key required)
GEOCODING_PROVIDER=nominatim

# Stationary & "Since" Detection Thresholds
STATIONARY_RADIUS_METERS=50
STATIONARY_DURATION_THRESHOLD_MS=180000

# CareRing AI Assistant & Voice Mode (ChatGPT Voice Style)
# Default LLM Provider: Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Free Voice Engine: Google Translate TTS + Device Native Speech (Zero API key required)

# Optional Server-level fallback keys (Users can also supply their personal keys in app)
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
