# Server Configuration
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://life360_user:life360_secure_password@localhost:5432/life360

# Reverse Geocoding Provider: 'nominatim' (free/no key needed) or 'google'
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stationary Detection Parameters (Rate-limiting reverse geocoding)
STATIONARY_RADIUS_METERS=50
STATIONARY_DURATION_THRESHOLD_MS=180000

# Firebase Cloud Messaging (FCM) for Push Alerts
FCM_SERVER_KEY=your_firebase_server_key_or_service_account
